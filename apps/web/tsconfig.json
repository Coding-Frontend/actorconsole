{
    "extends": "@actorconsole/config/tsconfig/nextjs.json",
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "5.0",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/**/*",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
