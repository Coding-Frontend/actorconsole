{
  "name": "@actorconsole/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ActorConsole marketing site, dashboard, and admin panel (Next.js 15).",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "node ../../scripts/check-web-boundary.mjs && next build",
    "start": "next start -p 8080",
