{
  "name": "actorconsole-web-staging",
  "main": "cloudflare-staging.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "API_BASE_URL": "https://api.actorconsole.com",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
