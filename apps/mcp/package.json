{
  "name": "@actorconsole/mcp",
  "version": "0.2.1",
  "description": "ActorConsole MCP server — bridge Apify Actor management into Claude Code, Codex, Cursor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coding-Frontend/actorconsole.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/Coding-Frontend/actorconsole/tree/main/apps/mcp#readme",
  "bugs": {
    "url": "https://github.com/Coding-Frontend/actorconsole/issues"
  },
  "keywords": [
    "mcp",
    "apify",
    "actorconsole",
    "claude",
    "codex",
    "cursor"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "actorconsole-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts --http",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0"
  },
  "devDependencies": {
    "@actorconsole/config": "workspace:*",
    "@actorconsole/shared": "workspace:*",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
