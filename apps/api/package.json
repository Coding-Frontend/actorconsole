{
  "name": "@actorconsole/api",
  "version": "0.0.0",
  "private": true,
  "description": "ActorConsole backend API (Hono).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@actorconsole/ai": "workspace:*",
    "@actorconsole/apify": "workspace:^",
    "@actorconsole/db": "workspace:*",
    "@actorconsole/logo-catalog": "workspace:*",
    "@actorconsole/shared": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/node": "^10.62.0",
    "bullmq": "^5.79.2",
    "cron-parser": "^4.9.0",
    "dodopayments": "2.55.0",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "nodemailer": "10.0.10",
    "octokit": "^5.0.5",
    "razorpay": "^2.9.8",
    "resend": "^6.34.1",
    "stripe": "22.4.0",
    "zod": "^4.6.7",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@actorconsole/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
