# Local backend environment. Keep backend credentials out of apps/web.
# Use .env.web.example for local frontend settings and .env.vps.example on the VPS.
# Runtime
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
API_HOST=127.0.0.1
MCP_PORT=4100
MCP_HOST=127.0.0.1
MCP_TRANSPORT=stdio
WORKER_CONCURRENCY=5
APIFY_STORE_DETAIL_BATCH_SIZE=5000
APIFY_STORE_DETAIL_CONCURRENCY=4
APIFY_STORE_DETAIL_BATCH_DELAY_MS=350
APIFY_STORE_RECONCILE_BUILDERS=true
APIFY_STORE_BUILDER_CONCURRENCY=4
APIFY_STORE_BUILDER_BATCH_DELAY_MS=150
# Optional safety cap. Leave unset to reconcile every Store builder daily.
# APIFY_STORE_MAX_BUILDERS=5000
APIFY_BULK_OPERATION_DELAY_MS=1000
ACTOR_SNAPSHOT_RETENTION_DAYS=90

# Infrastructure
# Local Docker bootstrap only; production DATABASE_URL uses your existing DB user.
MYSQL_APP_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://actorconsole:change-me@127.0.0.1:3306/actorconsole
REDIS_URL=redis://127.0.0.1:6379

# Application URLs
# The browser uses the same-origin Next.js API proxy at /api/.
AUTH_URL=http://localhost:8080
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=ActorConsole

# Core secrets (generate independent random values; never reuse them)
AUTH_SECRET=
ADMIN_API_KEY=
APP_ENCRYPTION_KEY=
# Legacy compatibility setting; hosted MCP verifies each caller's workspace key.
MCP_API_KEY=
# Workspace credential for local MCP stdio only; never reuse ADMIN_API_KEY.
ACTORCONSOLE_API_KEY=

# Backend Firebase token verification
FIREBASE_PROJECT_ID=

# Public Firebase client configuration; copy only these browser values to web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Persistent website-logo assets. In Docker, mount this path as a shared volume
# in both the API and worker containers.
WEBSITE_LOGO_STORAGE_PATH=.data/actorconsole-assets
WEBSITE_LOGO_ENRICHMENT_BATCH_SIZE=100
WEBSITE_LOGO_ENRICHMENT_DELAY_MS=150
WEBSITE_CLASSIFICATION_CONCURRENCY=25

# Apify
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_API_TOKEN=
# Optional Console token for hosted Actor pictures and AI category suggestions.
APIFY_UI_TOKEN=
# Preferred Console credential: backend ApifyRT cookie obtains the UI token automatically.
APIFY_COOKIES=

# AI providers

# Billing
# Explicit monthly/yearly Pro plans. Configure both intervals to offer both choices.
# Generic Pro IDs are not used for new checkout; a billing interval is required.
STRIPE_PRODUCT_ID_PRO_MONTH=
STRIPE_PRICE_ID_PRO_MONTH=
STRIPE_PRODUCT_ID_PRO_YEAR=
STRIPE_PRICE_ID_PRO_YEAR=
RAZORPAY_PLAN_ID_PRO_MONTH=
RAZORPAY_PLAN_ID_PRO_YEAR=
DODO_PRODUCT_ID_PRO_MONTH=
DODO_PRODUCT_ID_PRO_YEAR=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CALLBACK_URL=http://localhost:8080/dashboard/settings/billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_URL=http://localhost:8080/dashboard/settings/billing
RAZORPAY_PRODUCT_CREDITS_100_AMOUNT_PAISE=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
DODO_CALLBACK_URL=http://localhost:8080/dashboard/settings/billing

# Separate payment profiles (optional env fallback; choose checkout mode in Admin → Payment gateways)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRODUCT_ID_PRO_MONTH=
STRIPE_TEST_PRODUCT_ID_PRO_YEAR=
STRIPE_TEST_PRICE_ID_PRO_MONTH=
STRIPE_TEST_PRICE_ID_PRO_YEAR=
STRIPE_TEST_CALLBACK_URL=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRODUCT_ID_PRO_MONTH=
STRIPE_LIVE_PRODUCT_ID_PRO_YEAR=
STRIPE_LIVE_PRICE_ID_PRO_MONTH=
STRIPE_LIVE_PRICE_ID_PRO_YEAR=
STRIPE_LIVE_CALLBACK_URL=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_TEST_PLAN_ID_PRO_MONTH=
RAZORPAY_TEST_PLAN_ID_PRO_YEAR=
RAZORPAY_TEST_CALLBACK_URL=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
RAZORPAY_LIVE_PLAN_ID_PRO_MONTH=
RAZORPAY_LIVE_PLAN_ID_PRO_YEAR=
RAZORPAY_LIVE_CALLBACK_URL=
DODO_TEST_API_KEY=
DODO_TEST_WEBHOOK_SECRET=
DODO_TEST_BRAND_ID=
DODO_TEST_PRODUCT_ID_PRO_MONTH=
DODO_TEST_PRODUCT_ID_PRO_YEAR=
DODO_TEST_CALLBACK_URL=
DODO_LIVE_API_KEY=
DODO_LIVE_WEBHOOK_SECRET=
DODO_LIVE_BRAND_ID=
DODO_LIVE_PRODUCT_ID_PRO_MONTH=
DODO_LIVE_PRODUCT_ID_PRO_YEAR=
DODO_LIVE_CALLBACK_URL=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=ActorConsole <hello@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SUPPORT_EMAIL=support@example.com

# Observability (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=actorconsole-web
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SAMPLE_RATE=1
GIT_SHA=

# Optional metrics and tracing credentials (backend only)
METRICS_TOKEN=
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OPTIMIZATION_WORKER_CONCURRENCY=2
MCP_INTERNAL_URL=http://localhost:4100

# One-time local admin bootstrap; clear after running db:seed:admin
ADMIN_SEED_PASSWORD=

# Policy seed configuration. Review drafts in Admin before publishing.
LEGAL_OPERATOR_NAME=Your organization
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_JURISDICTION=Your jurisdiction
