# Vercel Project Settings -> Environment Variables (apps/web).
# Next.js uses the API for all authentication and persisted data.
# No database, Redis, encryption, admin, mail, billing, or Apify credentials here.
NODE_ENV=production
API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=ActorConsole

# Firebase browser configuration; add the web domain to Firebase authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional Sentry configuration. AUTH_TOKEN is for source map upload during build.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=actorconsole-web
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SAMPLE_RATE=1

# Optional listing for your own published extension; otherwise link to self-hosting docs.
NEXT_PUBLIC_CHROME_EXTENSION_URL=
