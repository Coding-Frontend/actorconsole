# Copy to apps/web/.env.local for local Next.js development. Public values are bundled.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Optional verification tokens from Google Search Console and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_APP_NAME=ActorConsole
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional GA4 web stream linked to this Firebase app; analytics requires cookie consent.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Local DebugView validation only; restart Next.js after changing public variables.
NEXT_PUBLIC_FIREBASE_ANALYTICS_DEBUG=false
NEXT_PUBLIC_CHROME_EXTENSION_URL=
