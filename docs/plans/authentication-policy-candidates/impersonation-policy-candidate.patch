+import { Hono } from "hono";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ session: vi.fn(), admin: vi.fn() }));
+vi.mock("@actorconsole/db", () => ({ db: {
+  session: { findUnique: mocks.session }, user: { findUnique: mocks.admin },
+} }));
+import { requireAuth } from "../../src/middleware/auth.js";
+import { readWebSession } from "../../src/lib/web-session.js";
+
+const target = { id: "target", email: "target@example.test", name: null, image: null, role: "USER", plan: "FREE", suspendedAt: null };
+const session = {
+  expires: new Date(Date.now() + 60_000), user: target,
+  impersonatedById: "admin-a", impersonationExpiresAt: new Date(Date.now() + 60_000),
+};
+const boundary = new Hono().use("*", requireAuth()).get("/protected", (c) => c.json(c.get("session")));
+const headers = { cookie: "authjs.session-token=mimic-fixture" };
+
+describe("derived impersonation authority", () => {
+  beforeEach(() => { vi.resetAllMocks(); mocks.session.mockResolvedValue(session); });
+
+  it.each([
+    null,
+    { role: "USER", suspendedAt: null, deletionScheduledFor: null },
+    { role: "ADMIN", suspendedAt: new Date(), deletionScheduledFor: null },
+    { role: "SUPER_ADMIN", suspendedAt: null, deletionScheduledFor: new Date() },
+  ])("rejects protected and public session reads when the originating admin loses authority %#", async (admin) => {
+    mocks.admin.mockResolvedValue(admin);
+    const response = await boundary.request("/protected", { headers });
+    expect(response.status).toBe(401);
+    expect(await readWebSession(new Request("http://localhost/auth/session", { headers }))).toBeNull();
+    expect(mocks.admin).toHaveBeenCalledWith(expect.objectContaining({ where: { id: "admin-a" } }));
+  });
+
+  it.each(["ADMIN", "SUPER_ADMIN"])("preserves a valid %s impersonation", async (role) => {
+    mocks.admin.mockResolvedValue({ role, suspendedAt: null, deletionScheduledFor: null });
+    expect((await boundary.request("/protected", { headers })).status).toBe(200);
+    expect((await readWebSession(new Request("http://localhost/auth/session", { headers })))?.user.id).toBe(target.id);
+  });
+
+  it("does not add an authority lookup for an ordinary session", async () => {
+    mocks.session.mockResolvedValue({ ...session, impersonatedById: null, impersonationExpiresAt: null });
+    expect((await boundary.request("/protected", { headers })).status).toBe(200);
+    expect((await readWebSession(new Request("http://localhost/auth/session", { headers })))?.user.id).toBe(target.id);
+    expect(mocks.admin).not.toHaveBeenCalled();
+  });
+});
