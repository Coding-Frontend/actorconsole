@@ -0,0 +1,11 @@
+import { db } from "@actorconsole/db";
+
+/** A derived session cannot retain powers its originating administrator lost. */
+export async function hasImpersonationAuthority(adminId: string): Promise<boolean> {
+  const admin = await db.user.findUnique({
+    where: { id: adminId },
+    select: { role: true, suspendedAt: true, deletionScheduledFor: true },
+  });
+  return Boolean(admin && !admin.suspendedAt && !admin.deletionScheduledFor &&
+    (admin.role === "ADMIN" || admin.role === "SUPER_ADMIN"));
+}
