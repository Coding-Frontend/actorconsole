#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Forced SSH command: accepts one CI-built bundle for the supplied commit SHA.
readonly deploy_root="${ACTORCONSOLE_DEPLOY_ROOT:-/opt/actorconsole-vps}"
readonly releases_dir="${deploy_root}/releases"
readonly shared_dir="${deploy_root}/shared"
readonly project_name="${ACTORCONSOLE_COMPOSE_PROJECT:-actorconsole-vps}"
revision="${SSH_ORIGINAL_COMMAND:-}"
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || { echo "Expected a full commit SHA" >&2; exit 2; }
for command_name in curl docker flock node python3 mysqldump tar; do
  command -v "$command_name" >/dev/null || { echo "Missing command: $command_name" >&2; exit 2; }
done
mkdir -p "$releases_dir" "$shared_dir/backups"
exec 9>"${deploy_root}/deploy.lock"
flock -n 9 || { echo "Another deployment is running" >&2; exit 3; }
bundle_dir="$(mktemp -d /tmp/actorconsole-deploy.XXXXXX)"
release_dir="${releases_dir}/$(date -u +%Y%m%dT%H%M%SZ)-${revision:0:12}"
previous_release="$(readlink -f "${deploy_root}/current" 2>/dev/null || true)"
switch_started=0
compose_for() {
  ACTORCONSOLE_IMAGE_TAG="sha-${2:0:12}" ACTORCONSOLE_REVISION="$2" \
    docker compose -p "$project_name" --env-file "$1/.env.production" \
      -f "$1/docker-compose.vps.yml" "${@:3}"
}
cleanup() { rm -rf -- "$bundle_dir"; }
rollback() {
  local code=$?
  trap - ERR
  if [[ "$switch_started" == 1 && -d "$previous_release" ]]; then
    local previous_revision
    previous_revision="$(tr -d '[:space:]' < "$previous_release/REVISION")"
    if [[ "$previous_revision" =~ ^[0-9a-f]{40}$ ]]; then
      echo "Restoring previous application images; database migrations are not reversed" >&2
      compose_for "$previous_release" "$previous_revision" up -d --no-build --remove-orphans || true
    fi
  fi
  echo "Deployment failed; source retained at $release_dir" >&2
  exit "$code"
}
trap cleanup EXIT
trap rollback ERR
cat > "$bundle_dir/release.tar"
mkdir -m 700 "$release_dir"
# Only regular files/directories with safe relative paths may enter a release.
verify_bundle="${ACTORCONSOLE_VERIFY_BUNDLE:-/usr/local/lib/actorconsole/verify-vps-bundle.py}"
[[ -f "$verify_bundle" ]] || { echo "Installed bundle verifier missing" >&2; exit 2; }
python3 "$verify_bundle" "$bundle_dir" "$release_dir" "$revision"
rm -f "$bundle_dir/release.tar"
[[ -f "$shared_dir/.env.production" ]] || { echo "Server environment missing" >&2; exit 2; }
ln -s "$shared_dir/.env.production" "$release_dir/.env.production"
compose_for "$release_dir" "$revision" config --quiet

# Remove only obsolete ActorConsole image tags. Keep the currently running
# release available for application rollback; never prune other stacks/volumes.
previous_revision=""
[[ ! -f "$previous_release/REVISION" ]] || previous_revision="$(tr -d '[:space:]' < "$previous_release/REVISION")"
for service in api worker mcp web; do
  while IFS= read -r image; do
    [[ "$image" =~ :sha-[0-9a-f]{12}$ ]] || continue
    [[ "$image" == "actorconsole-vps-${service}:sha-${previous_revision:0:12}" ]] && continue
    [[ "$image" == "actorconsole-vps-${service}:sha-${revision:0:12}" ]] && continue
    docker image rm "$image" || true
  done < <(docker image ls "actorconsole-vps-$service" --format '{{.Repository}}:{{.Tag}}')
done
free_mb="$(df -Pm "$deploy_root" | awk 'NR==2 {print $4}')"
if (( free_mb < 4096 )); then
  echo "Refusing image load: less than 4 GiB free on the VPS" >&2
  exit 2
fi
echo "Loading CI-built images for ${revision:0:12}"
docker load -i "$bundle_dir/images.tar.gz"
rm -f "$bundle_dir/images.tar.gz"
for service in api worker mcp web; do
  image="actorconsole-vps-${service}:sha-${revision:0:12}"
  image_revision="$(docker image inspect "$image" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
  [[ "$image_revision" == "$revision" ]] || { echo "Image revision mismatch: $service" >&2; exit 2; }
done

# Preserve backend secrets and take a database backup before any migration.
database_url="$(sed -n 's/^DATABASE_URL=//p' "$shared_dir/.env.production" | tail -n 1)"
database_url="${database_url%\"}"; database_url="${database_url#\"}"
[[ -n "$database_url" ]] || { echo "DATABASE_URL missing" >&2; exit 2; }
database_url="$(BACKUP_DATABASE_URL="$database_url" node - <<'NODE'
const url = new URL(process.env.BACKUP_DATABASE_URL);
if (url.hostname === 'host.docker.internal') url.hostname = '127.0.0.1';
process.stdout.write(url.toString());
NODE
)"
DATABASE_URL="$database_url" BACKUP_DIR="$shared_dir/backups" BACKUP_RETENTION_DAYS=14 \
  bash "$release_dir/scripts/backup-db.sh"
compose_for "$release_dir" "$revision" run --rm --no-deps api \
  node node_modules/.bin/prisma migrate deploy --schema packages/db/prisma/schema.prisma
compose_for "$release_dir" "$revision" run --rm --no-deps api \
  node_modules/.bin/tsx scripts/seed-policies.ts
switch_started=1
compose_for "$release_dir" "$revision" up -d --no-build --remove-orphans
api_port="$(docker compose -p "$project_name" --env-file "$release_dir/.env.production" -f "$release_dir/docker-compose.vps.yml" port api 4000 | awk -F: '{print $NF}')"
web_port="$(docker compose -p "$project_name" --env-file "$release_dir/.env.production" -f "$release_dir/docker-compose.vps.yml" port web 8080 | awk -F: '{print $NF}')"
ready=0
for _ in $(seq 1 36); do
  if curl -fsS --max-time 5 "http://127.0.0.1:$api_port/health/ready" >/dev/null && \
     curl -fsS --max-time 5 "http://127.0.0.1:$web_port/api/health" | \
       EXPECTED_REVISION="$revision" node -e 'let s="";process.stdin.on("data",x=>s+=x);process.stdin.on("end",()=>{try{process.exit(JSON.parse(s).revision===process.env.EXPECTED_REVISION?0:1)}catch{process.exit(1)}})'; then
    ready=1; break
  fi
  sleep 5
done
[[ "$ready" == 1 ]] || { echo "Release failed readiness checks" >&2; false; }
ln -sfn "$release_dir" "$deploy_root/current"
switch_started=0
echo "Deployment complete: $revision"
compose_for "$release_dir" "$revision" ps
