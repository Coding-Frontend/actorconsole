{
  "name": "@actorconsole/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema and client for ActorConsole.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "studio": "prisma studio",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actorconsole/shared": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@actorconsole/config": "workspace:*",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
