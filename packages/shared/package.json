{
  "name": "@actorconsole/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas and TypeScript types for ActorConsole.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./default-dashboard": {
      "types": "./dist/default-dashboard.d.ts",
      "import": "./dist/default-dashboard.js"
    },
    "./actor-earnings": {
      "types": "./dist/actor-earnings.d.ts",
      "import": "./dist/actor-earnings.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./actor-intelligence": {
      "types": "./dist/actor-intelligence.d.ts",
      "import": "./dist/actor-intelligence.js"
    },
    "./plans": {
      "types": "./dist/plans.d.ts",
      "import": "./dist/plans.js"
    },
    "./ai-providers": {
      "types": "./dist/ai-providers.d.ts",
      "import": "./dist/ai-providers.js"
    },
    "./payment-gateways": {
      "types": "./dist/payment-gateways.d.ts",
      "import": "./dist/payment-gateways.js"
    },
    "./integrations-catalog": {
      "types": "./dist/integrations-catalog.d.ts",
      "import": "./dist/integrations-catalog.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./workspace-access": {
      "types": "./dist/workspace-access.d.ts",
      "import": "./dist/workspace-access.js"
    },
    "./web-session": {
      "types": "./dist/web-session.d.ts",
      "import": "./dist/web-session.js"
    },
    "./api-data": {
      "types": "./dist/api-data.d.ts",
      "import": "./dist/api-data.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@sentry/node": "^10.62.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actorconsole/config": "workspace:*",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
