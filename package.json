{
  "name": "actorconsole",
  "version": "0.1.0",
  "private": true,
  "description": "Operations tooling for Apify Actor builders.",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@actorconsole/web",
    "dev:api": "dotenv -e .env -- turbo run dev --filter=@actorconsole/api",
    "dev:mcp": "turbo run dev --filter=@actorconsole/mcp",
    "dev:worker": "turbo run dev --filter=@actorconsole/worker",
    "worker:once": "dotenv -e .env -- node apps/worker/dist/index.js --once",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:e2e": "playwright test",
    "test:charts": "playwright test --config e2e/charts.config.ts",
    "test:e2e:launch": "node scripts/run-e2e.mjs",
    "db:generate": "dotenv -e .env -- pnpm --filter @actorconsole/db generate",
    "db:push": "dotenv -e .env -- pnpm --filter @actorconsole/db push",
    "db:studio": "dotenv -e .env -- pnpm --filter @actorconsole/db studio",
    "db:seed:admin": "dotenv -e .env -- tsx scripts/seed-admin.ts",
    "db:seed:content": "dotenv -e .env -- tsx scripts/seed-policies.ts",
    "db:seed:dev": "dotenv -e .env.development -- npx tsx scripts/seed-policies.ts",
    "db:backup": "./scripts/backup-db.sh",
    "db:restore": "./scripts/restore-db.sh",
    "db:reset:dev": "dotenv -e .env.development -- pnpm --filter @actorconsole/db push --force-reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "setup:local": "node scripts/setup-local-env.mjs",
    "secrets:check": "gitleaks git --redact=100 --log-opts=--all",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build:backend": "dotenv -e .env -- turbo run build --filter=@actorconsole/api --filter=@actorconsole/worker",
    "db:migrate": "dotenv -e .env -- pnpm --filter @actorconsole/db migrate:deploy"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "ioredis": "5.11.1",
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.2",
      "brace-expansion@^2.0.0": "^2.1.7",
      "brace-expansion@^5.0.0": "^5.0.12",
      "postcss@8.4.31": "^8.5.31",
      "protobufjs@^7.0.0": "^7.6.5",
      "@grpc/grpc-js": "^1.14.5",
      "basic-ftp": "^6.2.3",
      "@prisma/config>deepmerge-ts": "^8.0.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
